# Copier ce fichier en .env puis renseigner les valeurs.

# Mot de passe de la base PostgreSQL (long et aléatoire).
POSTGRES_PASSWORD=a-remplacer

# Adresse publique de l'application (utilisée dans les e-mails).
BASE_URL=https://badge.proximy.net

TIMEZONE=Europe/Paris
SESSION_DUREE_JOURS=90
COOKIE_SECURE=true

# Géocodage des adresses (API Adresse de l'État). Mettre false si le serveur n'a pas accès à Internet.
GEOCODAGE_ACTIF=true

# Serveur d'envoi d'e-mails : laisser SMTP_HOST vide tant qu'il n'est pas fourni.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_FROM=badgeage@proximy.net

# Ports exposés par Nginx sur le serveur.
HTTP_PORT=80
HTTPS_PORT=443

# Nombre de processus web.
WEB_WORKERS=2
